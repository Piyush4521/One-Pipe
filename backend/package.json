{
  "name": "pipebot-backend",
  "version": "1.0.0",
  "description": "PipeBot Local Node.js Backend Service",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-env": "tsx src/config/env.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "helmet": "8.0.0",
    "mongoose": "8.24.7",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.13.4",
    "@types/supertest": "6.0.2",
    "@types/ws": "8.18.2",
    "pino-pretty": "13.0.0",
    "supertest": "7.0.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
