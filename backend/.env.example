# PipeBot Backend Environment Configuration Template
# Copy this file to .env for local configuration

# Runtime Environment (development | production | test)
NODE_ENV=development

# Server Network Configuration (bound to loopback by default)
PORT=5000
HOST=127.0.0.1

# Allowed Frontend Origins (comma-separated list for CORS validation)
# Explicitly configured for PipeBot React Vite dev server on port 3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Laptop Operator Access Secret (minimum 16 characters for authorized control)
# Must NEVER be committed to Git or exposed via public API endpoints
OPERATOR_TOKEN=pipebot-dev-operator-token-32ch

# Storage Driver (mongodb | memory - memory is test-only and forbidden in production)
STORAGE_DRIVER=mongodb

# Local MongoDB Configuration (bound strictly to 127.0.0.1 loopback; cloud/remote forbidden)
MONGODB_URI=mongodb://127.0.0.1:27017/pipebot
MONGODB_DB_NAME=pipebot

# Local Filesystem Storage Configuration
STORAGE_ROOT=D:\Pipe-Bot-2\storage
MAX_EVIDENCE_FILE_SIZE_BYTES=10485760
BACKUP_DIR=D:\Pipe-Bot-2\storage\backups
BACKUP_RETENTION_COUNT=5
MONGODUMP_PATH=mongodump
MONGORESTORE_PATH=mongorestore
